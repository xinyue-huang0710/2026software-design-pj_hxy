{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PJ1 SVG Tools",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/svg-tools",
        "${workspaceFolder}/extensions/svg-tools/examples"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/svg-tools/dist/**/*.cjs"
      ],
      "preLaunchTask": "build-svg-tools"
    }
  ]
}
